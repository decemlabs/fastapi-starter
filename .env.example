# Copy to .env and adjust. Nested settings use a double-underscore delimiter.
ENVIRONMENT=local

APP__NAME=fastapi-starter
APP__DEBUG=true
# JSON array; leave empty to disable CORS.
APP__CORS_ORIGINS=["http://localhost:3000"]

DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE__ECHO=false
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10

# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT__SECRET=please-change-this-to-a-long-random-string
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT__REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS__URL=redis://localhost:6379/0
